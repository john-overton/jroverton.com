# Rename file to .env.local and paste your Mapbox token here.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.34598usjfgjnadg.........
# Add Mineral from the Mapbox Gallery to your account, then paste the style URL here.
# Find it at: https://www.mapbox.com/gallery → search "Mineral" → "Add to your account"
# Then copy the style URL from Mapbox Studio → Styles page.
# Format: mapbox://styles/joverton/{style_id}
# Falls back to dark-v11 if not set.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox:randomurl.........
NEXT_PUBLIC_MAPBOX_STYLE_DARK=mapbox:randomurl.........
CLEARCUT_JWT_SECRET="randomstringofcharacters........."
PARALLAX_ADMIN_PASSWORD="<randompassword>"